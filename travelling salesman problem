
def tsp(graph, n):
    INF = float('inf')
    dp = [[INF] * n for _ in range(1 << n)]
    parent = [[-1] * n for _ in range(1 << n)]

    dp[1][0] = 0

    for mask in range(1 << n):
        for u in range(n):
            if dp[mask][u] == INF:
                continue

            for v in range(n):
                if mask & (1 << v) == 0 and graph[u][v] != INF:
                    new_mask = mask | (1 << v)
                    cost = dp[mask][u] + graph[u][v]

                    if cost < dp[new_mask][v]:
                        dp[new_mask][v] = cost
                        parent[new_mask][v] = u

    full_mask = (1 << n) - 1
    min_cost = INF
    last_city = -1

    for u in range(1, n):
        if graph[u][0] != INF:
            cost = dp[full_mask][u] + graph[u][0]

            if cost < min_cost:
                min_cost = cost
                last_city = u

    if min_cost == INF:
        print("No complete tour exists.")
        return

    path = []
    mask = full_mask
    city = last_city

    while city != 0:
        path.append(city)
        prev = parent[mask][city]
        mask ^= (1 << city)
        city = prev

    path.append(0)
    path.reverse()
    path.append(0)

    print("Minimum cost:", min_cost)
    print("Optimal tour:", " -> ".join(map(str, path)))


n = int(input("Enter number of cities: "))

print("Enter cost matrix (use 99999 for no route):")
graph = []

for i in range(n):
    row = list(map(int, input().split()))
    graph.append([
        float('inf') if x == 99999 else x for x in row
    ])

tsp(graph, n)

